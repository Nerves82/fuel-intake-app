@page "/"
@using FuelIntake.Core.TestData
@using FuelIntake.UI.Services
@inject IntakeSession Session

@* Preview shortcuts: /?sample=0&screen=Household opens a test client on that screen. *@
@if (ready)
{
    <FuelIntake.UI.AppRoot />
}

@code {
    [SupplyParameterFromQuery] public int? Sample { get; set; }
    [SupplyParameterFromQuery(Name = "screen")] public string? ScreenName { get; set; }
    [SupplyParameterFromQuery(Name = "notes")] public int? ShowNotes { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public int? SettingsTab { get; set; }
    [SupplyParameterFromQuery(Name = "lastname")] public string? NewLast { get; set; }
    [SupplyParameterFromQuery(Name = "paper")] public int? Paper { get; set; }
    [SupplyParameterFromQuery(Name = "clients")] public int? SeedClients { get; set; }
    [Inject] public FuelIntake.Core.Import.IPendingImports Pending { get; set; } = default!;
    private bool ready;

    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();
        if (Sample is int i && i >= 0 && i < SampleIntakes.All.Count)
            await Session.CreateAsync("Testy", "Sampleton" + (i + 1), SampleIntakes.All[i].Build);
        if (Session.Record is { } r && Sample is not null)
        {
            // show the vendor details in the preview
            r.FuelElectric.Vendor ??= Session.Vendors.FuelVendors.FirstOrDefault()?.DisplayName;
            r.FuelElectric.ElectricProvider ??= Session.Vendors.ElectricProviders.FirstOrDefault()?.DisplayName;
            Session.Changed();
        }
        if (ShowNotes == 1 && Session.Record is { } rec)
        {
            FuelIntake.Core.Activity.ActivityLog.AddNote(rec, new("Sam Placeholder", null), DateTimeOffset.Now.AddHours(-3), "Client called: tank at 1/8, delivery needed before the weekend.");
            FuelIntake.Core.Activity.ActivityLog.AddNote(rec, Session.Me, DateTimeOffset.Now.AddMinutes(-20), "Left voicemail with Example Oil about a Friday delivery.\nWill follow up at 3.");
            FuelIntake.Core.Activity.ActivityLog.AddNote(rec, Session.Me, DateTimeOffset.Now.AddMinutes(-5), "Card shows a different last digit — check with client.",
                new FuelIntake.UI.Services.FieldScope(FuelIntake.UI.Services.Screen.Household).Within("Member 1").RefFor("SSN"));
            Session.ToggleNotes();
        }
        if (NewLast is { Length: > 0 } && Session.Record is { } opened)
        {
            // preview a corrected spelling: the rename banner appears
            opened.Client.LastName = NewLast;
            Session.Changed();
            await Session.SaveAsync();
        }
        if (Paper is 1)
        {
            // preview the approval page with a few values "read" and some already checked
            var imp = new FuelIntake.Core.Import.PaperImport { CreatedAt = DateTimeOffset.Now, CreatedBy = Session.Me,
                Fields = FuelIntake.Core.Import.ImportFieldCatalog.NewImport(2), MemberCount = 2 };
            void Read(string path, string v, double c) { var f = imp.Fields.First(x => x.Path == path); f.Value = f.ReadValue = v; f.Confidence = c; }
            Read("client.lastName", "Sampleton", .9); Read("client.firstName", "Testy", .9); Read("client.dateOfBirth", "04/09/1951", .7);
            Read("client.zip", "0581", .4); Read("household[0].ssn", "000-12-3401", .8); Read("client.benefits.snap", "Yes", .95);
            foreach (var f in imp.Fields.Take(3)) FuelIntake.Core.Import.PaperImportRules.SetConfirmed(f, true, Session.Me, DateTimeOffset.Now);
            var id = await Pending.CreateAsync(imp, ["page1.pdf", "page2.pdf"]);
            Session.OpenPendingImport(id);
        }
        if (SeedClients is 1)
        {
            // preview the compliance badges in the clients list: picked, from the grant source, none
            await Session.CreateAsync("Testy", "Warmthson", SampleIntakes.All[0].Build, "Warmth");
            await Session.CreateAsync("Testy", "Granterly", SampleIntakes.All[1].Build);
            Session.Record!.Application.ComplianceStandard = null;
            Session.Record.FuelElectric.FuelOrder.FundingSource = "Crisis Fuel";
            Session.Changed(); await Session.SaveAsync();
            await Session.CreateAsync("Testy", "Plainfield", SampleIntakes.All[2].Build);
            Session.Record!.FuelElectric.FuelOrder.FundingSource = null;
            Session.Record.FuelElectric.ElectricPledge.FundingSource = null;
            Session.Record.FuelElectric.Invoice.FundingSource = null;
            Session.Changed(); await Session.SaveAsync();
            await Session.CloseAsync();
        }
        if (SettingsTab is int t) Session.SettingsTab = t;
        if (Enum.TryParse<Screen>(ScreenName, true, out var s)) Session.Go(s);
        ready = true;
    }
}
