@using System.Globalization
@inject FuelIntake.UI.Services.IntakeSession Session
@* Compact money input for table cells (no label line). The parent records the change. *@
@{ var issue = Session.IssueAt(Path); }
<div class="money cell @(problem ? "has-problem" : "") @Field.IssueClass(issue)" title="@issue?.Message" @attributes="Scope?.Attributes(Label ?? string.Empty)">
    <NoteMarker Label="@(Label ?? string.Empty)" />
    <span>$</span>
    <input type="text" inputmode="decimal" aria-label="@Label" title="@(problem ? "Enter a dollar amount like 291.50" : null)"
           value="@(Value?.ToString("#,##0.00", CultureInfo.GetCultureInfo("en-US")))" @onchange="OnChange" />
</div>

@code {
    [Parameter] public decimal? Value { get; set; }
    [Parameter] public EventCallback<decimal?> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    /// <summary>The record path, so a Review issue about this amount marks the cell ("incomeExpenses.income.SSA").</summary>
    [Parameter] public string? Path { get; set; }
    [CascadingParameter] public FieldScope? Scope { get; set; }
    private bool problem;

    private async Task OnChange(ChangeEventArgs e)
    {
        var text = (e.Value as string ?? "").Replace("$", "").Replace(",", "").Trim();
        if (text.Length == 0) { problem = false; await ValueChanged.InvokeAsync(null); return; }
        if (decimal.TryParse(text, NumberStyles.Number, CultureInfo.InvariantCulture, out var d) && d >= 0)
        {
            problem = false;
            await ValueChanged.InvokeAsync(Math.Round(d, 2));
        }
        else problem = true;
    }
}
