<section class="card">
    <h2>@Title</h2>
    @if (!string.IsNullOrEmpty(Note))
    {
        <p class="note">@Note</p>
    }
    <div class="grid">@ChildContent</div>
</section>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Note { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
