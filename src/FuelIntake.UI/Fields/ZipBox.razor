@using FuelIntake.Core.Formatting
@inherits FieldBase<string?>
<Field Label="@Label" Issue="@Issue" Path="@FieldPath" For="@Id" Hint="@Hint" Problem="@Problem">
    <input id="@Id" type="text" inputmode="numeric" maxlength="5" value="@Value" placeholder="05819" @onchange="e => SetAsync(e.Value as string)" />
</Field>

@code {
    protected override string? Problem =>
        !string.IsNullOrWhiteSpace(Value) && !Zip.IsValid(Value) ? "Exactly 5 numbers, e.g. 05819." : null;
}
