@inherits FieldBase<string?>
@inject IJSRuntime JS
@*
  A dropdown. With AllowOther, its last entry lets the user type a value that isn't on the list (shown with a note).
  (Not the browser's <datalist>: that only lists the options matching what's already in the box, so a filled-in
  field showed just its own value.)
  The plain dropdown draws its own list in the page instead of using the browser's <select> popup: in the
  desktop app (WebView2 inside WPF) the native popup of long lists could close as soon as it opened.
*@
<Field Label="@Label" Issue="@Issue" For="@Id" Hint="@Hint" Problem="@Problem" Wide="Wide">
    @if (AllowOther && typing)
    {
        @* a name that isn't on the list: typed in, then back to the dropdown *@
        <input id="@Id" type="text" value="@Value" placeholder="Type the name, then press Enter"
               @onchange="TypedAsync" @onkeydown="TypingKey" />
    }
    else
    {
        var items = Items;
        <div class="picker @(open ? "open" : "")">
            <button type="button" id="@Id" class="picker-button" aria-haspopup="listbox" aria-expanded="@(open ? "true" : "false")"
                    @onclick="Toggle" @onkeydown="Key" @onkeydown:preventDefault="open">
                <span class="picker-value @(string.IsNullOrEmpty(Value) ? "empty" : "")">@(string.IsNullOrEmpty(Value) ? "—" : Value)</span>
                <span class="picker-caret" aria-hidden="true">▾</span>
            </button>
            @if (open)
            {
                <div class="picker-backdrop" @onclick="Close"></div>
                <ul class="picker-list" id="@(Id + "-list")" role="listbox" aria-labelledby="@Id">
                    @for (var i = 0; i < items.Count; i++)
                    {
                        var index = i;
                        var item = items[i];
                        <li role="option" aria-selected="@(item.Value == Value ? "true" : "false")"
                            class="@(index == active ? "active" : "") @(item.Value == Value ? "chosen" : "") @(item.Value is null ? "none" : "") @(item.Value == OtherChoice ? "other" : "")"
                            @onclick="() => Pick(item.Value)" @onmousemove="() => Hover(index)">@item.Text</li>
                    }
                </ul>
            }
        </div>
    }
</Field>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<string> Options { get; set; } = [];
    [Parameter] public bool AllowOther { get; set; }
    [Parameter] public string? NotOnListNote { get; set; }

    private bool open, place, typing, focusTyping;

    /// <summary>The list entry that switches to typing (a value no option can have).</summary>
    private const string OtherChoice = "\u0001other";

    private async Task TypedAsync(ChangeEventArgs e)
    {
        typing = false;
        await SetAsync(string.IsNullOrWhiteSpace(e.Value as string) ? null : ((string)e.Value!).Trim());
    }

    private void TypingKey(KeyboardEventArgs e)
    {
        if (e.Key is "Escape" or "Esc") typing = false;
    }
    private int active;

    protected override string? Problem =>
        AllowOther && !string.IsNullOrWhiteSpace(Value) && !Options.Contains(Value.Trim(), StringComparer.OrdinalIgnoreCase)
            ? NotOnListNote : null;

    private sealed record Item(string? Value, string Text);

    /// <summary>"—" (blank), then a saved value that's no longer on the list, then the options.</summary>
    private List<Item> Items
    {
        get
        {
            var list = new List<Item> { new(null, "—") };
            if (!string.IsNullOrEmpty(Value) && !Options.Contains(Value)) list.Add(new(Value, Value + " (not on list)"));
            list.AddRange(Options.Select(o => new Item(o, o)));
            if (AllowOther) list.Add(new(OtherChoice, "Type a name not on the list…"));
            return list;
        }
    }

    private async Task Toggle() { if (open) await Close(); else Open(); }

    private void Open()
    {
        var i = Items.FindIndex(x => x.Value == (string.IsNullOrEmpty(Value) ? null : Value));
        active = Math.Max(0, i);
        open = true;
        place = true;
    }

    private async Task Close()
    {
        open = false;
        await Focus();
    }

    private void Hover(int index) { if (active != index) active = index; }

    private async Task Pick(string? value)
    {
        open = false;
        if (value == OtherChoice)
        {
            typing = true;
            focusTyping = true;
            return;
        }
        if (value != (string.IsNullOrEmpty(Value) ? null : Value)) await SetAsync(value);
        await Focus();
    }

    private async Task Key(KeyboardEventArgs e)
    {
        var items = Items;
        if (!open)
        {
            // Enter and Space reach the button as a click, which opens the list
            if (e.Key is "ArrowDown" or "ArrowUp" or "Down" or "Up" || (e.Key.Length == 1 && e.Key != " " && !e.CtrlKey && !e.AltKey))
            {
                Open();
                if (e.Key.Length == 1) Jump(items, e.Key);
            }
            return;
        }
        switch (e.Key)
        {
            case "ArrowDown" or "Down": active = Math.Min(items.Count - 1, active + 1); place = true; break;
            case "ArrowUp" or "Up": active = Math.Max(0, active - 1); place = true; break;
            case "Home": active = 0; place = true; break;
            case "End": active = items.Count - 1; place = true; break;
            case "PageDown": active = Math.Min(items.Count - 1, active + 8); place = true; break;
            case "PageUp": active = Math.Max(0, active - 8); place = true; break;
            case "Enter" or " ": await Pick(items[active].Value); break;
            case "Escape" or "Esc" or "Tab": await Close(); break;
            default:
                if (e.Key.Length == 1 && !e.CtrlKey && !e.AltKey) Jump(items, e.Key);
                break;
        }
    }

    /// <summary>Type a letter to jump to the next option starting with it.</summary>
    private void Jump(List<Item> items, string letter)
    {
        for (var step = 1; step <= items.Count; step++)
        {
            var i = (active + step) % items.Count;
            if (items[i].Value?.StartsWith(letter, StringComparison.OrdinalIgnoreCase) == true) { active = i; place = true; return; }
        }
    }

    private async Task Focus()
    {
        try { await JS.InvokeVoidAsync("fuelIntake.focus", Id); } catch (JSException) { } catch (InvalidOperationException) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusTyping)
        {
            focusTyping = false;
            await Focus();
            return;
        }
        if (!open || !place) return;
        place = false;
        try { await JS.InvokeVoidAsync("fuelIntake.placeList", Id + "-list", active); }
        catch (JSException) { } catch (InvalidOperationException) { }
    }
}
