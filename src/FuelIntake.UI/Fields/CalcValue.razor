@* A calculated (read-only) value, shown in blue like the workbook's calculated cells. *@
<div class="field calc @(Wide ? "wide" : "")">
    <label>@Label</label>
    <div class="calc-value @(Strong ? "strong" : "")">@(string.IsNullOrEmpty(Value) ? "—" : Value)</div>
    @if (!string.IsNullOrEmpty(Hint))
    {
        <div class="hint">@Hint</div>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? Value { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public bool Wide { get; set; }
    [Parameter] public bool Strong { get; set; }
}
