@using FuelIntake.Core.Formatting
@inherits FieldBase<string?>
<Field Label="@Label" For="@Id" Hint="@Hint" Problem="@Problem">
    <input id="@Id" type="text" autocomplete="off" value="@Value" placeholder="012-34-5678" @onchange="e => SetAsync(e.Value as string)" />
</Field>

@code {
    protected override string? Problem =>
        !string.IsNullOrWhiteSpace(Value) && !Ssn.IsValid(Value) ? "Needs 9 digits (dashes optional). Keep leading zeros." : null;
}
