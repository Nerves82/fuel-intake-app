@*
  The compliance standard tag beside a client in the clients list. Each standard has its own colour (its place in
  the settings list). Solid = picked for the client; dashed outline + "via grant" = applies because of the grant
  source on the order; red = the picked standard was removed from the settings.
*@
@if (Badge is { } b)
{
    <span class="badge compliance @(b.Unknown ? "unknown" : $"std-{b.Color}") @(b.FromGrant ? "from-grant" : "")" title="@b.Tooltip">@b.Label</span>
}

@code {
    [Parameter] public FuelIntake.Core.Compliance.ComplianceBadge? Badge { get; set; }
}
