@* Approval page for a paper application: every field is checked against the scan and ticked
   "This is correct" before the client can be created. Saved as you go, so it can take several sessions. *@
@using FuelIntake.Core.Import
@inject IntakeSession Session
@inject IPendingImports Pending
@inject IScanReader Reader
@inject IJSRuntime JS

<main class="page verify-page">
    @if (loadError is not null)
    {
        <h1>Paper application</h1>
        <p class="problem">@loadError</p>
        <button class="secondary" @onclick="Session.LeavePendingImport">Back to clients</button>
    }
    else if (import is null)
    {
        <p class="note">Loading…</p>
    }
    else
    {
        var done = PaperImportRules.ConfirmedCount(import);
        var total = import.Fields.Count;
        var blockers = PaperImportRules.Blockers(import, Session.Today);
        <div class="verify-head">
            <div>
                <h1>@PaperImportRules.DisplayName(import) <span class="badge pending">pending verification</span></h1>
                <p class="lead">Check each field against the scan. Fix it if needed, then tick <strong>This is correct</strong>.
                    Blank fields need a tick too, so nothing the reader missed slips through. Everything is saved as you go.</p>
            </div>
            <div class="verify-progress">
                <strong>@done of @total checked</strong>
                <progress max="@total" value="@done"></progress>
                <button class="secondary small" disabled="@(done == total)" @onclick="NextUnchecked">Next unchecked ↓</button>
            </div>
        </div>

        <div class="banner inline-banner read-status">
            @if (reading)
            {
                <span>@(readProgress ?? "Reading the scans…") This can take a few seconds per page.</span>
            }
            else
            {
                <span>@(import.ReadNote ?? (import.ScanFiles.Count == 0 ? "No scans to read." : "The scans haven't been read yet."))</span>
                @if (import.ScanFiles.Count > 0 && Reader.Unavailable is null)
                {
                    <button class="secondary small" @onclick="ReadScans" title="Updates fields that are unticked and that you haven't changed">Read the scans again</button>
                }
            }
        </div>

        @if (import.ReadLayout is { Length: > 0 } layout)
        {
            <details class="read-layout">
                <summary>What the reader saw (names and numbers hidden)</summary>
                <p class="note">If fields were missed, copy this and send it to whoever maintains the app: it shows the printed labels and where
                    things sit on the page, with the client's details replaced by x and 9, so the reading can be improved safely.</p>
                <button class="secondary small" @onclick="() => Copy(layout)">Copy</button> @if (copied) { <span class="ok">Copied.</span> }
                <pre>@layout</pre>
            </details>
        }

        <div class="verify-layout">
            <div class="verify-fields">
                @foreach (var group in import.Fields.Select((f, i) => (f, i)).GroupBy(x => x.f.Group))
                {
                    <section class="card">
                        <h2>@group.Key <span class="note">@group.Count(x => x.f.Confirmed) of @group.Count() checked</span></h2>
                        @foreach (var (f, i) in group)
                        {
                            var field = f;
                            var problem = PaperImportRules.Problem(field, Session.Today);
                            <div class="verify-row @(field.Confirmed ? "confirmed" : "") @(problem is null ? "" : "has-problem")" id="imp-@i">
                                <div class="verify-input">
                                    @switch (field.Kind)
                                    {
                                        case ImportFieldKind.Check:
                                            <CheckBox Label="@field.Label" Value="@(field.Value == PaperImportRules.Checked)"
                                                      ValueChanged="v => SetValue(field, v ? PaperImportRules.Checked : null)" Hint="ticked on the form" />
                                            break;
                                        case ImportFieldKind.Choice when field.Options is { Count: > 0 } options:
                                            <SelectBox Label="@field.Label" Value="@field.Value" ValueChanged="v => SetValue(field, v)" Options="options" />
                                            break;
                                        default:
                                            <TextBox Label="@field.Label" Value="@field.Value" ValueChanged="v => SetValue(field, v)" Placeholder="@Placeholder(field.Kind)"
                                                     Hint="@(field.ReadValue is { } read && read != field.Value ? $"Read from scan: {read}" : null)" />
                                            break;
                                    }
                                    @if (problem is not null) { <div class="problem">@problem</div> }
                                    else if (field.Confidence is < 0.5 && field.Value == field.ReadValue && !string.IsNullOrEmpty(field.Value))
                                    {
                                        <div class="unsure">Unsure reading: check this one closely</div>
                                    }
                                </div>
                                <label class="confirm">
                                    <input type="checkbox" checked="@field.Confirmed" @onchange="e => Confirm(field, e.Value is true)" />
                                    <span>This is correct@(string.IsNullOrWhiteSpace(field.Value) && field.Kind != ImportFieldKind.Check ? " (left blank)" : "")</span>
                                    @if (field.Confirmed && field.ConfirmedBy is { } by && by.Name != Session.Me.Name)
                                    {
                                        <small>by @by.Name</small>
                                    }
                                </label>
                            </div>
                        }
                        @if (group.Key.StartsWith("Member", StringComparison.Ordinal) && group.Key == ImportFieldCatalog.MemberGroup(import.MemberCount))
                        {
                            <div class="actions">
                                <button class="secondary small" @onclick="AddMember">+ Add household member</button>
                                @if (import.MemberCount > 1)
                                {
                                    <button class="link danger" @onclick="RemoveMember">Remove member @import.MemberCount</button>
                                }
                            </div>
                        }
                    </section>
                }

                <section class="card verify-finish">
                    <h2>Create the client</h2>
                    @if (blockers.Count > 0)
                    {
                        <ul class="problems">@foreach (var b in blockers) { <li class="warning">@b</li> }</ul>
                    }
                    else
                    {
                        <p class="ok">Every field is checked. Creating the client makes the folder <strong>@PaperImportRules.DisplayName(import)</strong>,
                            moves the scans into it and opens the Review tab.</p>
                    }
                    @if (message is not null) { <p class="@(messageIsError ? "problem" : "ok")">@message</p> }
                    <div class="actions">
                        <button disabled="@(blockers.Count > 0 || busy)" @onclick="Create">@(busy ? "Creating…" : "Create client")</button>
                        <button class="secondary" @onclick="Session.LeavePendingImport">Finish later</button>
                        <span class="spacer"></span>
                        @if (confirmDiscard)
                        {
                            <span class="note">Throw away this application and its scans (Recycle Bin)?</span>
                            <button class="danger" @onclick="Discard">Yes, discard</button>
                            <button class="link" @onclick="() => confirmDiscard = false">Keep</button>
                        }
                        else
                        {
                            <button class="link danger" @onclick="() => confirmDiscard = true">Discard application…</button>
                        }
                    </div>
                </section>
            </div>

            <aside class="verify-scan">
                @if (import.ScanFiles.Count == 0)
                {
                    <p class="note">No scans attached.</p>
                }
                else
                {
                    <div class="subtabs">
                        @foreach (var file in import.ScanFiles)
                        {
                            var f = file;
                            <button class="@(f == scan ? "active" : "")" title="@f" @onclick="() => scan = f">@f</button>
                        }
                    </div>
                    @if (scan is not null && Pending.ViewUrl(Session.PendingImportId!, scan) is { } url)
                    {
                        <iframe class="scan-view" src="@url" title="Scanned page"></iframe>
                    }
                    else
                    {
                        <p class="note">Scans show here in the desktop app.</p>
                    }
                }
            </aside>
        </div>
    }
</main>

@code {
    private PaperImport? import;
    private bool copied;

    private async Task Copy(string text)
    {
        try { await JS.InvokeVoidAsync("fuelIntake.copy", text); copied = true; } catch (Exception) { copied = false; }
    }
    private bool reading;
    private string? readProgress;
    private string? loadError, message, scan;
    private bool busy, messageIsError, confirmDiscard;
    private readonly SemaphoreSlim saving = new(1, 1);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            import = await Pending.GetAsync(Session.PendingImportId!);
            scan = import.ScanFiles.FirstOrDefault();
        }
        catch (Exception ex) { loadError = "Couldn't open this paper application: " + ex.Message; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // read the scans the first time the application is opened
        if (firstRender && import is { ReadAt: null, ScanFiles.Count: > 0 }) await ReadScans();
    }

    /// <summary>Reads the scans on this computer and fills blank, unticked fields (staff still check every one).</summary>
    private async Task ReadScans()
    {
        if (import is null || reading) return;
        if (Reader.Unavailable is { } why)
        {
            import.ReadNote = "The scans couldn't be read automatically: " + why + " Type the values from the scan.";
            StateHasChanged();
            return;
        }
        reading = true; readProgress = null;
        StateHasChanged();
        try
        {
            var id = Session.PendingImportId!;
            var scans = import.ScanFiles.Select(f => (f, Pending.ScanLocation(id, f))).Where(x => x.Item2 is not null)
                .Select(x => (x.f, x.Item2!)).ToList();
            var progress = new Progress<string>(p => { readProgress = p; InvokeAsync(StateHasChanged); });
            var pages = await Task.Run(() => Reader.ReadAsync(scans, progress));
            var filled = ScanFieldReader.Fill(import, pages);
            import.ReadLayout = ScanFieldReader.MaskedLayout(pages.Select(ScanFieldReader.Rows).ToList());
            var words = pages.Sum(p => p.Lines.Sum(l => l.Words.Count));
            import.ReadNote = words == 0
                ? $"Read {pages.Count} page{(pages.Count == 1 ? "" : "s")} but found no text. The scan may be too faint or handwritten; type the values from the scan."
                : $"Read {pages.Count} page{(pages.Count == 1 ? "" : "s")}: filled in {filled} field{(filled == 1 ? "" : "s")}. " +
                  "Check every one against the scan; unsure readings are marked.";
        }
        catch (Exception ex)
        {
            import.ReadNote = "The scans couldn't be read automatically (" + ex.Message + "). Type the values from the scan.";
        }
        finally
        {
            import.ReadAt = DateTimeOffset.Now;
            reading = false;
            await Save();
            StateHasChanged();
        }
    }

    private static string? Placeholder(ImportFieldKind k) => k switch
    {
        ImportFieldKind.Date => "MM/DD/YYYY",
        ImportFieldKind.Money => "$",
        ImportFieldKind.Ssn => "123-45-6789",
        ImportFieldKind.Phone => "802-555-0100",
        _ => null,
    };

    private Task SetValue(ImportField f, string? value)
    {
        PaperImportRules.SetValue(f, value); // a changed value needs ticking again
        return Save();
    }

    private Task Confirm(ImportField f, bool on)
    {
        PaperImportRules.SetConfirmed(f, on, Session.Me, DateTimeOffset.Now);
        return Save();
    }

    private Task AddMember() { PaperImportRules.AddMember(import!); return Save(); }
    private Task RemoveMember() { PaperImportRules.RemoveLastMember(import!); return Save(); }

    private async Task Save()
    {
        await saving.WaitAsync();
        try
        {
            await Pending.SaveAsync(Session.PendingImportId!, import!);
            if (messageIsError) message = null;
        }
        catch (Exception ex) { message = "Couldn't save your checks: " + ex.Message; messageIsError = true; }
        finally { saving.Release(); }
    }

    private async Task NextUnchecked()
    {
        var i = import!.Fields.FindIndex(f => !f.Confirmed);
        if (i < 0) return;
        try { await JS.InvokeAsync<bool>("fuelIntake.reveal", $"imp-{i}"); } catch (Exception) { }
    }

    private async Task Create()
    {
        busy = true; message = null;
        var id = Session.PendingImportId!;
        try
        {
            await Session.CreateFromPaperAsync(import!);
        }
        catch (Exception ex)
        {
            message = "Couldn't create the client: " + ex.Message; messageIsError = true;
            busy = false;
            return;
        }
        try { await Pending.FinishAsync(id, Session.Folder!.Id); }
        catch (Exception ex)
        {
            Session.ShowNotice("The client was created, but the scans couldn't be moved into its folder: " + ex.Message +
                               " They're still in the holding folder; move them by hand.");
        }
        busy = false;
    }

    private async Task Discard()
    {
        try
        {
            await Pending.DiscardAsync(Session.PendingImportId!);
            Session.LeavePendingImport();
        }
        catch (Exception ex) { message = "Couldn't discard: " + ex.Message; messageIsError = true; }
    }
}
