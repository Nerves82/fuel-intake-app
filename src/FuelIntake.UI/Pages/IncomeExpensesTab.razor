@inject IntakeSession Session
@{ var ie = Session.Record!.IncomeExpenses; var calc = Session.Calc!; }

<h1>4 · Income/Expense worksheet &amp; ACCESS income</h1>
<p class="lead">Monthly amounts. Totals, Income − Expenses and FPL % calculate automatically.</p>

<div class="two-col">
    <section class="card">
        <h2>Gross monthly income</h2>
        <CascadingValue Value="@(Scope?.Within("Income"))">
        <table class="lines">
            <tbody>
                @foreach (var line in IncomeExpenseCatalog.IncomeLines)
                {
                    <tr>
                        <td>@line.Label</td>
                        <td><MoneyCell Value="@Income(line.Key)" ValueChanged="v => SetIncome(line.Key, v)" Label="@line.Label" Path="@($"incomeExpenses.income.{line.Key}")" /></td>
                    </tr>
                    @if (line.Key == "Other")
                    {
                        <tr class="line-note">
                            <td colspan="2"><TextBox Label="Other income: what is it?" @bind-Value="ie.IncomeOtherDescription" Placeholder="e.g. help from family, rental income" /></td>
                        </tr>
                    }
                }
                <tr class="total"><td>Total gross monthly income</td><td>@Money.Format(calc.IncomeTotal)</td></tr>
            </tbody>
        </table>
        </CascadingValue>
        <div class="grid">
            <RadioGroup Label="Any income change in the next month?" @bind-Value="ie.IncomeChangeNextMonth" Options="ChoiceLists.YesNo" />
            @if (ie.IncomeChangeNextMonth == "Yes")
            {
                <TextBox Label="If yes, explain" @bind-Value="ie.IncomeChangeExplanation" Multiline="true" Wide="true" />
            }
        </div>
    </section>

    <section class="card">
        <h2>Expenses</h2>
        <CascadingValue Value="@(Scope?.Within("Expenses"))">
        <table class="lines">
            <thead><tr><th></th><th>Paid in last 30 days</th><th>Bills</th></tr></thead>
            <tbody>
                @foreach (var line in IncomeExpenseCatalog.ExpenseLines)
                {
                    <tr>
                        <td>@line.Label</td>
                        <td><MoneyCell Value="@Expense(line.Key).PaidLast30Days" ValueChanged="v => SetExpense(line.Key, e => e.PaidLast30Days = v)" Label="@($"{line.Label} paid")" Path="@($"incomeExpenses.expenses.{line.Key}.paidLast30Days")" /></td>
                        <td><MoneyCell Value="@Expense(line.Key).Bill" ValueChanged="v => SetExpense(line.Key, e => e.Bill = v)" Label="@($"{line.Label} bill")" Path="@($"incomeExpenses.expenses.{line.Key}.bill")" /></td>
                    </tr>
                }
                <tr class="total"><td>Total expenses</td><td>@Money.Format(calc.ExpensesPaidTotal)</td><td>@Money.Format(calc.ExpensesBillTotal)</td></tr>
            </tbody>
        </table>
        </CascadingValue>
    </section>
</div>

<Section Title="Summary & assets">
    <CalcValue Label="Income − Expenses (uses Paid in last 30 days)" Value="@Money.Format(calc.IncomeMinusExpenses)" Strong="true" />
    <MoneyBox Label="Checking" @bind-Value="ie.AssetChecking" />
    <MoneyBox Label="Savings" @bind-Value="ie.AssetSavings" />
    <MoneyBox Label="Cash" @bind-Value="ie.AssetCash" />
    <MoneyBox Label="CDs/Stocks/Bonds" @bind-Value="ie.AssetCdsStocksBonds" />
    <MoneyBox Label="401K/403B/Retirement" @bind-Value="ie.AssetRetirement" />
    <TextBox Label="Explanation / notes" @bind-Value="ie.Notes" Multiline="true" Wide="true" />
</Section>

<Section Title="Eligibility">
    <CalcValue Label="Household members (from tab 2)" Value="@calc.HouseholdSize.ToString()" />
    <CalcValue Label="100% FPL for this household ($/yr)" Value="@(calc.AnnualGuideline is { } g ? g.ToString("$#,##0") : "")"
               Hint="@($"{Session.Settings.PovertyGuidelines.Year} HHS guidelines")" />
    <CalcValue Label="FPL % (monthly income × 12 ÷ guideline)" Value="@Percent.Format(calc.FplPercent)" Strong="true" />
    <CalcValue Label="@($"Under {Percent.Format(Session.Settings.IncomeLimit)} FPL?")" Value="@(calc.UnderIncomeLimit switch { true => "Yes", false => "No", _ => "" })" Strong="true" />
    <CheckBox Label="Documents attached for 30 days income" @bind-Value="ie.DocumentsAttached30Days" />
    @if (!calc.HouseholdIncomeMatchesWorksheet)
    {
        <p class="problem wide">Household income column (@Money.Format(calc.HouseholdIncomeColumnTotal)) doesn't match the total above — check both tabs.</p>
    }
</Section>

<NextTab Next="Screen.FuelElectric" />

@code {
    [CascadingParameter] public FieldScope? Scope { get; set; }

    private decimal? Income(string key) => Session.Record!.IncomeExpenses.Income.GetValueOrDefault(key);

    private void SetIncome(string key, decimal? v)
    {
        var d = Session.Record!.IncomeExpenses.Income;
        if (v is null) d.Remove(key); else d[key] = v;
        Session.Changed();
    }

    private ExpenseAmounts Expense(string key) =>
        Session.Record!.IncomeExpenses.Expenses.GetValueOrDefault(key) ?? new ExpenseAmounts();

    private void SetExpense(string key, Action<ExpenseAmounts> set)
    {
        var d = Session.Record!.IncomeExpenses.Expenses;
        var e = d.GetValueOrDefault(key) ?? new ExpenseAmounts();
        set(e);
        if (e.PaidLast30Days is null && e.Bill is null) d.Remove(key); else d[key] = e;
        Session.Changed();
    }
}
