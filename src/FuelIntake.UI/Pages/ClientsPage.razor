@using FuelIntake.Core.Storage
@using FuelIntake.Core.TestData
@inject IntakeSession Session
@inject ITestDataSets TestSets
@inject IDataFolder Folder
@inject FuelIntake.Core.Import.IPendingImports Pending
@inject FuelIntake.Core.Import.IFilePicker Picker

<main class="page narrow">
    @if (Session.Notice is not null)
    {
        <div class="banner inline-banner">@Session.Notice <button class="link" @onclick="Session.DismissNotice">Dismiss</button></div>
    }
    <section class="hero">
        <img src="_content/FuelIntake.UI/nekca-logo.png" alt="NEKCA — Together We Grow" />
        <div>
            <h1>Crisis Fuel &amp; Electric Assistance</h1>
            <p>Northeast Kingdom Community Action · intake, eligibility and print packets</p>
        </div>
    </section>

    <section class="card">
        <h2>New client</h2>
        <div class="grid">
            <div class="field"><label for="nf">First name</label><input id="nf" @bind="first" @bind:event="oninput" /></div>
            <div class="field"><label for="nl">Last name</label><input id="nl" @bind="last" @bind:event="oninput" /></div>
        </div>
        @if (Session.Compliance.Standards.Count > 0)
        {
            <div class="grid">
                <SelectBox Label="Compliance standard" @bind-Value="standard"
                           Options="Session.Compliance.Standards.Select(s => s.Name).ToList()"
                           Hint="Optional. Blank uses the one linked to the grant source. Can be changed later on the Review tab." />
            </div>
        }
        @if (nameProblem is not null) { <p class="problem">@nameProblem</p> }
        <div class="actions">
            <button disabled="@busy" @onclick="() => Create(null)">Create client folder</button>
        </div>
        <details class="test-tools">
            <summary>Practice with test data</summary>
            <p class="note">Creates a <strong>_TEST</strong> folder filled with made-up data. Never use this for a real client.</p>
            <p class="note">Uses the name typed above for the client (a blank first or last name becomes Testy / Sampleton).</p>
            <h3>Built-in cases</h3>
            <ul class="sample-list">
                @foreach (var s in SampleIntakes.All)
                {
                    <li>
                        <button class="secondary" disabled="@busy" @onclick="() => Create(s)">@s.Name</button>
                        <span class="note">@s.Description</span>
                    </li>
                }
            </ul>
            <h3>Saved test data sets</h3>
            @if (savedSets.Count == 0)
            {
                <p class="note">None yet. Open a test client, set it up the way you want, then use <strong>Save as test data set</strong> on its Review tab.</p>
            }
            else
            {
                <ul class="sample-list">
                    @foreach (var t in savedSets)
                    {
                        <li>
                            <button class="secondary" disabled="@busy" @onclick="() => Create(TestDataSetRules.AsSample(t))">@t.Name</button>
                            <span class="note">@t.Description @(t.SavedBy is { } by ? $"· saved by {by.Name}" : "") @t.SavedAt.ToLocalTime().ToString("MMM d, yyyy")</span>
                            @if (confirmDelete == t.Id)
                            {
                                <button class="link danger" @onclick="() => DeleteSet(t)">Yes, delete</button>
                                <button class="link" @onclick="() => confirmDelete = null">Keep</button>
                            }
                            else
                            {
                                <button class="link" title="Delete this saved set (test clients made from it stay)" @onclick="() => confirmDelete = t.Id">Delete</button>
                            }
                        </li>
                    }
                </ul>
            }
            @if (setsError is not null) { <p class="problem">@setsError</p> }
        </details>
    </section>

    <section class="card paper-box">
        <h2>New client from paper application</h2>
        <p class="note">Choose the scanned pages of a filled-in paper application. You'll then check every field against the scan,
            ticking <strong>This is correct</strong> for each, before the client is created. It can be done over several sessions.</p>
        @if (Picker.CanPick)
        {
            <button class="secondary" disabled="@busy" @onclick="StartPaper">Choose scanned pages…</button>
        }
        else
        {
            <button class="secondary" disabled="@busy" @onclick="StartPaper" title="The preview can't pick files: starts an empty one">Start (no scans in the preview)</button>
        }
        @if (paperError is not null) { <p class="problem">@paperError</p> }
        @if (pending.Count > 0)
        {
            <h3>Pending verification</h3>
            <ul class="client-list">
                @foreach (var p in pending)
                {
                    <li>
                        <button class="link" @onclick="() => Session.OpenPendingImport(p.Id)">@p.DisplayName</button>
                        <span class="badge pending">pending verification</span>
                        <span class="note">@p.Confirmed of @p.Total checked · started @p.CreatedAt.ToLocalTime().ToString("MMM d")@(p.CreatedBy is { } by ? $" by {by.Name}" : "")</span>
                    </li>
                }
            </ul>
        }
    </section>

    @if (recentShown.Count > 0)
    {
        <section class="card">
            <h2>Recently opened</h2>
            <ul class="client-list">
                @foreach (var (c, at) in recentShown)
                {
                    <li>
                        <button class="link" @onclick="() => Session.OpenAsync(c)">@c.DisplayName</button>
                        @if (c.DisplayName.StartsWith(ClientFolders.TestPrefix)) { <span class="badge test">TEST</span> }
                        <ComplianceTag Badge="@BadgeOf(c)" />
                        <span class="note" title="@at.ToLocalTime().ToString("MMM d, yyyy h:mm tt")">opened @Ago(at)</span>
                    </li>
                }
            </ul>
        </section>
    }

    <section class="card">
        <div class="row-between">
            <h2>All clients</h2>
            <input class="search" placeholder="Search names…" @bind="search" @bind:event="oninput" />
        </div>
        @if (clients is null)
        {
            <p class="note">Loading…</p>
        }
        else if (error is not null)
        {
            <p class="problem">@error</p>
            <p><button class="link" @onclick="Session.GoToDataFolder">Choose the client files folder</button></p>
        }
        else
        {
            var shown = clients.Where(c => string.IsNullOrWhiteSpace(search) || c.DisplayName.Contains(search, StringComparison.OrdinalIgnoreCase)).ToList();
            if (shown.Count == 0 && pending.Count == 0)
            {
                <p class="note">No client folders yet.</p>
            }
            <p class="note folder-line">In <code>@Folder.Current.Path</code>
                @if (Folder.Current.SyncedFrom is not null) { <span class="badge synced">@Folder.Current.SyncedFrom</span> }
                · <button class="link" @onclick="Session.GoToDataFolder">change</button></p>
            @if (badges.Values.Any(b => b is not null))
            {
                <p class="note tag-key">Compliance tags: <span class="badge compliance std-0">filled</span> = picked for the client ·
                    <span class="badge compliance std-0 from-grant">outlined · via grant</span> = applies because of the grant source on the order ·
                    each standard has its own colour.</p>
            }
            <ul class="client-list">
                @foreach (var p in pending.Where(p => string.IsNullOrWhiteSpace(search) || p.DisplayName.Contains(search, StringComparison.OrdinalIgnoreCase)))
                {
                    <li>
                        <button class="link" @onclick="() => Session.OpenPendingImport(p.Id)">@p.DisplayName</button>
                        <span class="badge pending">pending verification</span>
                        <span class="note">@p.Confirmed of @p.Total checked</span>
                    </li>
                }
                @foreach (var c in shown)
                {
                    <li>
                        <button class="link" @onclick="() => Session.OpenAsync(c)">@c.DisplayName</button>
                        @if (c.DisplayName.StartsWith(ClientFolders.TestPrefix)) { <span class="badge test">TEST</span> }
                        @if (!c.HasIntake) { <span class="badge">no intake yet</span> }
                        <ComplianceTag Badge="@BadgeOf(c)" />
                        <span class="note">@c.LastModified?.ToLocalTime().ToString("MMM d, yyyy")</span>
                    </li>
                }
            </ul>
        }
    </section>
</main>

@code {
    private IReadOnlyList<ClientFolderInfo>? clients;
    private List<(ClientFolderInfo Client, DateTimeOffset At)> recentShown = [];

    private string Ago(DateTimeOffset at)
    {
        var span = DateTimeOffset.Now - at;
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes} min ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours} hr ago";
        if (span.TotalDays < 2) return "yesterday";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays} days ago";
        return at.ToLocalTime().ToString("MMM d");
    }
    private string? error, nameProblem, search, first, last, standard, setsError, confirmDelete, paperError;
    private IReadOnlyList<FuelIntake.Core.Import.PendingImportInfo> pending = [];

    private async Task LoadPending()
    {
        try { pending = await Pending.ListAsync(); }
        catch (Exception) { pending = []; } // the client list shows the folder problem
    }

    private async Task StartPaper()
    {
        paperError = null;
        try
        {
            var scans = await Picker.PickScansAsync();
            if (Picker.CanPick && scans.Count == 0) return; // cancelled
            busy = true;
            var import = new FuelIntake.Core.Import.PaperImport
            {
                CreatedBy = Session.Me, CreatedAt = DateTimeOffset.Now,
                Fields = FuelIntake.Core.Import.ImportFieldCatalog.NewImport(),
            };
            var id = await Pending.CreateAsync(import, scans);
            Session.OpenPendingImport(id);
        }
        catch (Exception ex) { paperError = "Couldn't start the paper application: " + ex.Message; }
        finally { busy = false; }
    }
    private IReadOnlyList<TestDataSet> savedSets = [];

    private async Task LoadSets()
    {
        try { savedSets = await TestSets.ListAsync(); setsError = null; }
        catch (Exception ex) { savedSets = []; setsError = "Couldn't read saved test data sets: " + ex.Message; }
    }

    private async Task DeleteSet(TestDataSet t)
    {
        confirmDelete = null;
        try { await TestSets.DeleteAsync(t.Id); }
        catch (Exception ex) { setsError = "Couldn't delete: " + ex.Message; }
        await LoadSets();
    }
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        try { clients = await Session.ListClientsAsync(); }
        catch (Exception ex) { error = "Couldn't read the client folders: " + ex.Message; clients = []; }
        try
        {
            // only folders that still exist (renamed or removed folders drop off)
            var byId = clients.ToDictionary(c => c.Id, StringComparer.OrdinalIgnoreCase);
            recentShown = (await Session.RecentClientsAsync())
                .Where(r => byId.ContainsKey(r.Id)).Select(r => (byId[r.Id], r.OpenedAt)).ToList();
        }
        catch { recentShown = []; }
        await LoadSets();
        await LoadPending();
        // show the badges with the list when they come quickly (a short list); otherwise they fill in as read
        var badgesLoading = LoadBadges();
        await Task.WhenAny(badgesLoading, Task.Delay(300));
    }

    // compliance badges: read in the background so the list shows at once
    private readonly Dictionary<string, FuelIntake.Core.Compliance.ComplianceBadge?> badges = new(StringComparer.OrdinalIgnoreCase);
    private FuelIntake.Core.Compliance.ComplianceBadge? BadgeOf(ClientFolderInfo c) => badges.GetValueOrDefault(c.Id);

    private async Task LoadBadges()
    {
        var list = clients ?? [];
        try
        {
            for (var i = 0; i < list.Count; i += 8)
            {
                var batch = list.Skip(i).Take(8).ToList();
                var found = await Task.WhenAll(batch.Select(c => Session.BadgeAsync(c)));
                for (var j = 0; j < batch.Count; j++) badges[batch[j].Id] = found[j];
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { /* badges are a convenience */ }
    }

    private async Task Create(SampleIntakes.Sample? sample)
    {
        var f = first?.Trim() ?? ""; var l = last?.Trim() ?? "";
        if (sample is not null)
        {
            // test data: use whatever name was typed; only a missing part gets the made-up default
            if (f.Length == 0) f = "Testy";
            if (l.Length == 0) l = "Sampleton";
        }
        if (f.Length == 0 || l.Length == 0) { nameProblem = "Enter both first and last name."; return; }
        if (ClientFolders.SafeName(f) != f || ClientFolders.SafeName(l) != l)
        {
            nameProblem = "Names can't contain \\ / : * ? \" < > | # %";
            return;
        }
        nameProblem = null; busy = true;
        try { await Session.CreateAsync(f, l, sample?.Build, standard); }
        catch (Exception ex) { nameProblem = ex.Message; }
        finally { busy = false; }
    }
}
