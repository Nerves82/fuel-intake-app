@using FuelIntake.Core.Validation
@using FuelIntake.Core.TestData
@inject IntakeSession Session
@inject ITestDataSets TestSets
@inject TimeProvider Clock
@{ var calc = Session.Calc!; }

<h1>Review</h1>
<p class="lead">Fix errors before printing. Warnings are worth a look; notes are just information. When it looks right, go to <button class="link" @onclick="() => Session.Go(Screen.Print)">Print</button>.</p>

<section class="card">
    <div class="summary-strip">
        <span>Household <strong>@calc.HouseholdSize</strong></span>
        <span>Income <strong>@Money.Format(calc.IncomeTotal)</strong>/mo</span>
        <span>FPL <strong>@(calc.FplPercent is null ? "—" : Percent.Format(calc.FplPercent))</strong></span>
        <span>Under limit <strong>@(calc.UnderIncomeLimit switch { true => "Yes", false => "No", _ => "—" })</strong></span>
        <span>Crisis <strong>@(Session.Record!.Application.CrisisType ?? "—")</strong></span>
    </div>
</section>

@if (Session.Issues.Count == 0)
{
    <section class="card"><p class="ok">No problems found.</p></section>
}
else
{
    @foreach (var group in Session.Issues.OrderByDescending(i => i.Severity).GroupBy(i => i.Severity))
    {
        <section class="card">
            <h2 class="@group.Key.ToString().ToLowerInvariant()">@Title(group.Key) (@group.Count())</h2>
            <ul class="issues">
                @foreach (var i in group)
                {
                    <li>
                        <button class="link" @onclick="() => Session.Go(ScreenFor(i.Section))">@i.Section</button>
                        <span>@i.Message</span>
                    </li>
                }
            </ul>
        </section>
    }
}

@if (Session.Record!.IsTestData)
{
    <section class="card test-save">
        <h2>Save as test data set</h2>
        <p class="note">Saves this test client's data so anyone can start a new test client from it under
            <strong>Practice with test data</strong>. Notes, activity and staff details aren't saved.</p>
        <div class="grid">
            <div class="field"><label for="tsn">Name</label><input id="tsn" maxlength="@TestDataSetRules.MaxNameLength" @bind="setName" @bind:event="oninput" placeholder="e.g. Propane, over income, phone app" /></div>
            <div class="field"><label for="tsd">What it tests (optional)</label><input id="tsd" @bind="setDescription" @bind:event="oninput" /></div>
        </div>
        @if (setMessage is not null) { <p class="@(setSaved ? "ok" : "problem")">@setMessage</p> }
        <div class="actions"><button class="secondary" disabled="@savingSet" @onclick="SaveTestSet">Save test data set</button></div>
    </section>
}

<section class="card">
    <h2>Activity</h2>
    @{ var r = Session.Record!; }
    @if (r.CreatedBy is { } creator)
    {
        <p class="note">Created by <strong>@creator.Name</strong> @(r.CreatedAt?.ToLocalTime().ToString("MMM d, yyyy h:mm tt"))</p>
    }
    @if (r.Activity.Count == 0)
    {
        <p class="note">No changes recorded yet.</p>
    }
    <ul class="activity">
        @foreach (var g in Enumerable.Reverse(FuelIntake.Core.Activity.ActivityLog.Group(r.Activity, TimeZoneInfo.Local)))
        {
            var other = r.CreatedBy is { } c && !FuelIntake.Core.Activity.ActivityLog.SamePerson(c, g.By);
            var from = g.From.ToLocalTime(); var to = g.To.ToLocalTime();
            <li class="@(other ? "other" : "")">
                <div>
                    <strong>@from.ToString("MMM d, h:mm tt")@(to - from >= TimeSpan.FromMinutes(1) ? $" – {to:h:mm tt}" : "")</strong> — @g.By.Name
                    @if (other) { <span class="badge other-staff">other staff</span> }
                    · @g.Summary
                </div>
                @if (g.FieldChanges.Count > 0 || g.NoteEntries.Count > 0)
                {
                    <details>
                        <summary>Show changes</summary>
                        <table class="changes">
                            @foreach (var ch in g.FieldChanges)
                            {
                                <tr><td>@ch.Field</td><td class="from">@(string.IsNullOrEmpty(ch.From) ? "(blank)" : ch.From)</td><td>→</td><td>@(string.IsNullOrEmpty(ch.To) ? "(blank)" : ch.To)</td></tr>
                            }
                            @foreach (var n in g.NoteEntries)
                            {
                                foreach (var ch in n.Changes)
                                {
                                    <tr class="note-row"><td>@n.At.ToLocalTime().ToString("h:mm tt") @n.Action.ToLowerInvariant()</td><td colspan="3">@(ch.To ?? ch.From) <span class="note">(@ch.Field)</span></td></tr>
                                }
                            }
                        </table>
                    </details>
                }
            </li>
        }
    </ul>
</section>

@code {
    private string? setName, setDescription, setMessage;
    private bool savingSet, setSaved;

    private async Task SaveTestSet()
    {
        if (string.IsNullOrWhiteSpace(setName)) { setSaved = false; setMessage = "Give the test data set a name."; return; }
        savingSet = true;
        try
        {
            var existing = (await TestSets.ListAsync()).FirstOrDefault(x => string.Equals(x.Name, setName.Trim(), StringComparison.CurrentCultureIgnoreCase));
            var set = TestDataSetRules.FromRecord(Session.Record!, setName, setDescription, Session.Me, Clock.GetLocalNow());
            if (existing is not null) set.Id = existing.Id; // same name replaces it
            await TestSets.SaveAsync(set);
            setSaved = true;
            setMessage = existing is null ? $"Saved \"{set.Name}\"." : $"Replaced the earlier \"{set.Name}\".";
        }
        catch (Exception ex) { setSaved = false; setMessage = "Couldn't save: " + ex.Message; }
        finally { savingSet = false; }
    }

    private static string Title(IssueSeverity s) => s switch
    {
        IssueSeverity.Error => "Errors",
        IssueSeverity.Warning => "Warnings",
        _ => "Notes",
    };

    private static Screen ScreenFor(string section) => section switch
    {
        "Household" => Screen.Household,
        "Application" => Screen.Application,
        "Income & Expenses" => Screen.IncomeExpenses,
        "Fuel & Electric" => Screen.FuelElectric,
        _ => Screen.Client,
    };
}
