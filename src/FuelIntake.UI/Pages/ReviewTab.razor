@using FuelIntake.Core.Validation
@using FuelIntake.Core.TestData
@using FuelIntake.Core.Email
@using FuelIntake.Core.Packets
@using FuelIntake.UI.Printing
@inject IntakeSession Session
@inject PacketRenderer Renderer
@inject IPdfPrinter Printer
@inject FuelIntake.Core.Storage.IFileOutput Output
@inject IEmailComposer Mail
@inject ITestDataSets TestSets
@inject TimeProvider Clock
@{ var calc = Session.Calc!; }

<h1>Review</h1>
<p class="lead">Fix errors before printing. Warnings are worth a look; notes are just information. When it looks right, go to <button class="link" @onclick="() => Session.Go(Screen.Print)">Print</button>.</p>

<section class="card">
    <div class="summary-strip">
        <span>Household <strong>@calc.HouseholdSize</strong></span>
        <span>Income <strong>@Money.Format(calc.IncomeTotal)</strong>/mo</span>
        <span>FPL <strong>@(calc.FplPercent is null ? "—" : Percent.Format(calc.FplPercent))</strong></span>
        <span>Under limit <strong>@(calc.UnderIncomeLimit switch { true => "Yes", false => "No", _ => "—" })</strong></span>
        <span>Crisis <strong>@(Session.Record!.Application.CrisisType ?? "—")</strong></span>
    </div>
</section>

@if (Session.Issues.Count == 0)
{
    <section class="card"><p class="ok">No problems found.</p></section>
}
else
{
    @foreach (var group in Session.Issues.OrderByDescending(i => i.Severity).GroupBy(i => i.Severity))
    {
        <section class="card">
            <h2 class="@group.Key.ToString().ToLowerInvariant()">@Title(group.Key) (@group.Count())</h2>
            <ul class="issues">
                @foreach (var i in group)
                {
                    <li>
                        <button class="link" @onclick="() => Session.Go(ScreenFor(i.Section))">@i.Section</button>
                        <span>@i.Message</span>
                    </li>
                }
            </ul>
        </section>
    }
}

@if (Session.Record!.Application.CrisisType?.Trim() != CrisisTypes.DisconnectNotice)
{
    var rec = Session.Record!;
    var draft = FuelOrderEmail.Build(rec, calc, Session.Settings);
    var problems = FuelOrderEmail.Problems(rec, calc);
    <section class="card fuel-email">
        <h2>Email the Fuel Order to the vendor</h2>
        @if (problems.Count > 0)
        {
            <ul class="problems">@foreach (var p in problems) { <li class="warning">@p</li> }</ul>
        }
        else
        {
            <table class="changes mail-summary">
                <tr><td>To</td><td>@(rec.IsTestData ? "(left blank: this is test data, don't send it to the vendor)" : string.Join("; ", draft.To))</td></tr>
                <tr><td>Subject</td><td>@draft.Subject</td></tr>
                <tr><td>Attachment</td>
                    <td>
                        @if (savedPdf is not null && !newPdf)
                        {
                            <span>@savedPdf <span class="note">(already in the client's folder)</span></span>
                        }
                        else
                        {
                            <span>@FuelOrderEmail.PdfFileName(rec, Session.Today, Session.Settings.FileDateFormat)
                                <span class="note">(made now from tab 5 and saved to the client's folder)</span></span>
                        }
                        @if (savedPdf is not null)
                        {
                            <label class="check-line small"><input type="checkbox" @bind="newPdf" /> Make a new Fuel Order PDF (the order changed since @savedPdf was saved)</label>
                        }
                    </td></tr>
            </table>
            <details>
                <summary>Message</summary>
                <pre class="mail-body">@draft.Body</pre>
            </details>
            <p class="note">The email opens for you to check and send; nothing is sent automatically. Classic Outlook gets the PDF attached;
                with the new Outlook, use <strong>Use Outlook on the web</strong> and drag in the PDF from the folder that opens.
                Change the wording under <button class="link" @onclick="() => { Session.SettingsTab = 2; Session.Go(Screen.Settings); }">Staff, vendors &amp; settings → Agency settings</button>.</p>
            @if (mailMessage is not null) { <p class="@(mailError ? "problem" : "ok")">@mailMessage</p> }
            <div class="actions">
                <button disabled="@mailBusy" @onclick="() => CreateEmail(EmailRoute.Auto)">@(mailBusy ? "Working…" : "Create email")</button>
                <button class="secondary" disabled="@mailBusy" @onclick="() => CreateEmail(EmailRoute.OutlookWeb)"
                        title="For the new Outlook: opens a new message in Outlook on the web, and the folder with the PDF to drag in">Use Outlook on the web</button>
            </div>
        }
    </section>
}

@if (Session.Record!.IsTestData)
{
    <section class="card test-save">
        <h2>Save as test data set</h2>
        <p class="note">Saves this test client's data so anyone can start a new test client from it under
            <strong>Practice with test data</strong>. Notes, activity and staff details aren't saved.</p>
        <div class="grid">
            <div class="field"><label for="tsn">Name</label><input id="tsn" maxlength="@TestDataSetRules.MaxNameLength" @bind="setName" @bind:event="oninput" placeholder="e.g. Propane, over income, phone app" /></div>
            <div class="field"><label for="tsd">What it tests (optional)</label><input id="tsd" @bind="setDescription" @bind:event="oninput" /></div>
        </div>
        @if (setMessage is not null) { <p class="@(setSaved ? "ok" : "problem")">@setMessage</p> }
        <div class="actions"><button class="secondary" disabled="@savingSet" @onclick="SaveTestSet">Save test data set</button></div>
    </section>
}

<section class="card">
    <h2>Activity</h2>
    @{ var r = Session.Record!; }
    @if (r.CreatedBy is { } creator)
    {
        <p class="note">Created by <strong>@creator.Name</strong> @(r.CreatedAt?.ToLocalTime().ToString("MMM d, yyyy h:mm tt"))</p>
    }
    @if (r.Activity.Count == 0)
    {
        <p class="note">No changes recorded yet.</p>
    }
    <ul class="activity">
        @foreach (var g in Enumerable.Reverse(FuelIntake.Core.Activity.ActivityLog.Group(r.Activity, TimeZoneInfo.Local)))
        {
            var other = r.CreatedBy is { } c && !FuelIntake.Core.Activity.ActivityLog.SamePerson(c, g.By);
            var from = g.From.ToLocalTime(); var to = g.To.ToLocalTime();
            <li class="@(other ? "other" : "")">
                <div>
                    <strong>@from.ToString("MMM d, h:mm tt")@(to - from >= TimeSpan.FromMinutes(1) ? $" – {to:h:mm tt}" : "")</strong> — @g.By.Name
                    @if (other) { <span class="badge other-staff">other staff</span> }
                    · @g.Summary
                </div>
                @if (g.FieldChanges.Count > 0 || g.NoteEntries.Count > 0)
                {
                    <details>
                        <summary>Show changes</summary>
                        <table class="changes">
                            @foreach (var ch in g.FieldChanges)
                            {
                                <tr><td>@ch.Field</td><td class="from">@(string.IsNullOrEmpty(ch.From) ? "(blank)" : ch.From)</td><td>→</td><td>@(string.IsNullOrEmpty(ch.To) ? "(blank)" : ch.To)</td></tr>
                            }
                            @foreach (var n in g.NoteEntries)
                            {
                                foreach (var ch in n.Changes)
                                {
                                    @if (n.Action == FuelIntake.Core.Activity.ActivityLog.RenamedAction)
                                    {
                                        <tr class="note-row"><td>@n.At.ToLocalTime().ToString("h:mm tt") renamed (@ch.Field.ToLowerInvariant())</td><td class="from">@ch.From</td><td>→</td><td>@ch.To</td></tr>
                                    }
                                    else
                                    {
                                        <tr class="note-row"><td>@n.At.ToLocalTime().ToString("h:mm tt") @n.Action.ToLowerInvariant()</td><td colspan="3">@(ch.To ?? ch.From) <span class="note">(@ch.Field)</span></td></tr>
                                    }
                                }
                            }
                        </table>
                    </details>
                }
            </li>
        }
    </ul>
</section>

<section class="card danger-zone">
    <h2>Delete this client</h2>
    @if (!deleteOpen)
    {
        <p class="note">Removes the whole client folder, including the PDFs and any other files in it.</p>
        <button class="secondary danger-outline" @onclick="StartDelete">Delete client…</button>
    }
    else
    {
        var rec = Session.Record!;
        <p>This moves the folder <strong>@Session.Folder?.DisplayName</strong> and everything in it to the Recycle Bin.
            @if (deleteFiles is { Count: > 0 } files)
            {
                <span>It holds @files.Count item@(files.Count == 1 ? "" : "s"):</span>
            }
        </p>
        @if (deleteFiles is { Count: > 0 } list)
        {
            <ul class="delete-files">
                @foreach (var f in list.Take(15)) { <li>@f</li> }
                @if (list.Count > 15) { <li class="note">…and @(list.Count - 15) more</li> }
            </ul>
        }
        @if (!rec.IsTestData)
        {
            <p class="warn">This is a real client's file. Check your agency's record-keeping rules before deleting it.</p>
        }
        <div class="field">
            <label for="del-confirm">Type the client's last name (<strong>@rec.Client.LastName</strong>) to confirm</label>
            <input id="del-confirm" autocomplete="off" @bind="deleteTyped" @bind:event="oninput" />
        </div>
        @if (deleteError is not null) { <p class="problem">@deleteError</p> }
        <div class="actions">
            <button class="danger" disabled="@(deleting || !FuelIntake.Core.Storage.ClientFolders.DeleteConfirmed(deleteTyped, rec.Client.LastName))"
                    @onclick="Delete">@(deleting ? "Deleting…" : "Move folder to Recycle Bin")</button>
            <button class="secondary" disabled="@deleting" @onclick="() => { deleteOpen = false; deleteTyped = null; deleteError = null; }">Cancel</button>
        </div>
    }
</section>

@code {
    private string? savedPdf, mailMessage;
    private bool newPdf, mailBusy, mailError;

    protected override async Task OnInitializedAsync()
    {
        try { savedPdf = FuelOrderEmail.FindSavedPdf(await Session.ClientFilesAsync(), Session.Record!, Session.Settings.FileDateFormat); }
        catch (Exception) { savedPdf = null; } // can't list the folder: a new PDF will be made
    }

    private async Task CreateEmail(EmailRoute route)
    {
        mailBusy = true; mailMessage = null; mailError = false;
        try
        {
            var rec = Session.Record!;
            await Session.SaveAsync();
            string location, file;
            if (savedPdf is not null && !newPdf)
            {
                file = savedPdf;
                location = Output.LocationOf(Session.Folder!.Id, file);
            }
            else
            {
                file = FuelOrderEmail.PdfFileName(rec, Session.Today, Session.Settings.FileDateFormat);
                var context = new PrintContext(rec, Session.Calc!, Session.Settings, Session.Today);
                var html = await Renderer.RenderAsync(context, [FormId.FuelOrder], Path.GetFileNameWithoutExtension(file));
                var pdf = await Printer.PrintAsync(html);
                location = await Output.SaveAsync(Session.Folder!.Id, file, pdf);
                file = Path.GetFileName(location);
                savedPdf = file; newPdf = false;
            }
            var draft = FuelOrderEmail.Build(rec, Session.Calc!, Session.Settings);
            if (rec.IsTestData) draft = draft with { To = [] };
            var opened = await Mail.ComposeAsync(draft, location, route);
            mailMessage = opened.Attached
                ? $"Opened in {opened.How} with {file} attached. Check it and press Send."
                : $"Opened in {opened.How}. The PDF can't be attached this way: drag {file} from the folder window that opened into the email, then send.";
        }
        catch (Exception ex)
        {
            mailError = true;
            mailMessage = "Couldn't create the email: " + ex.Message;
        }
        finally { mailBusy = false; }
    }
    private bool deleteOpen, deleting;
    private string? deleteTyped, deleteError;
    private IReadOnlyList<string>? deleteFiles;

    private async Task StartDelete()
    {
        deleteOpen = true; deleteTyped = null; deleteError = null;
        try { deleteFiles = await Session.ClientFilesAsync(); }
        catch (Exception ex) { deleteFiles = null; deleteError = "Couldn't list the folder: " + ex.Message; }
    }

    private async Task Delete()
    {
        if (!FuelIntake.Core.Storage.ClientFolders.DeleteConfirmed(deleteTyped, Session.Record?.Client.LastName)) return;
        deleting = true; deleteError = null;
        try { await Session.DeleteCurrentClientAsync(); }
        catch (Exception ex) { deleteError = "Couldn't delete: " + ex.Message; }
        finally { deleting = false; }
    }

    private string? setName, setDescription, setMessage;
    private bool savingSet, setSaved;

    private async Task SaveTestSet()
    {
        if (string.IsNullOrWhiteSpace(setName)) { setSaved = false; setMessage = "Give the test data set a name."; return; }
        savingSet = true;
        try
        {
            var existing = (await TestSets.ListAsync()).FirstOrDefault(x => string.Equals(x.Name, setName.Trim(), StringComparison.CurrentCultureIgnoreCase));
            var set = TestDataSetRules.FromRecord(Session.Record!, setName, setDescription, Session.Me, Clock.GetLocalNow());
            if (existing is not null) set.Id = existing.Id; // same name replaces it
            await TestSets.SaveAsync(set);
            setSaved = true;
            setMessage = existing is null ? $"Saved \"{set.Name}\"." : $"Replaced the earlier \"{set.Name}\".";
        }
        catch (Exception ex) { setSaved = false; setMessage = "Couldn't save: " + ex.Message; }
        finally { savingSet = false; }
    }

    private static string Title(IssueSeverity s) => s switch
    {
        IssueSeverity.Error => "Errors",
        IssueSeverity.Warning => "Warnings",
        _ => "Notes",
    };

    private static Screen ScreenFor(string section) => section switch
    {
        "Household" => Screen.Household,
        "Application" => Screen.Application,
        "Income & Expenses" => Screen.IncomeExpenses,
        "Fuel & Electric" => Screen.FuelElectric,
        _ => Screen.Client,
    };
}
