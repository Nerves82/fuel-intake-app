@using FuelIntake.Core.Validation
@inject IntakeSession Session
@{ var calc = Session.Calc!; }

<h1>Review</h1>
<p class="lead">Fix errors before printing. Warnings are worth a look; notes are just information. When it looks right, go to <button class="link" @onclick="() => Session.Go(Screen.Print)">Print</button>.</p>

<section class="card">
    <div class="summary-strip">
        <span>Household <strong>@calc.HouseholdSize</strong></span>
        <span>Income <strong>@Money.Format(calc.IncomeTotal)</strong>/mo</span>
        <span>FPL <strong>@(calc.FplPercent is null ? "—" : Percent.Format(calc.FplPercent))</strong></span>
        <span>Under limit <strong>@(calc.UnderIncomeLimit switch { true => "Yes", false => "No", _ => "—" })</strong></span>
        <span>Crisis <strong>@(Session.Record!.Application.CrisisType ?? "—")</strong></span>
    </div>
</section>

@if (Session.Issues.Count == 0)
{
    <section class="card"><p class="ok">No problems found.</p></section>
}
else
{
    @foreach (var group in Session.Issues.OrderByDescending(i => i.Severity).GroupBy(i => i.Severity))
    {
        <section class="card">
            <h2 class="@group.Key.ToString().ToLowerInvariant()">@Title(group.Key) (@group.Count())</h2>
            <ul class="issues">
                @foreach (var i in group)
                {
                    <li>
                        <button class="link" @onclick="() => Session.Go(ScreenFor(i.Section))">@i.Section</button>
                        <span>@i.Message</span>
                    </li>
                }
            </ul>
        </section>
    }
}

<section class="card">
    <h2>Activity</h2>
    @{ var r = Session.Record!; }
    @if (r.CreatedBy is { } creator)
    {
        <p class="note">Created by <strong>@creator.Name</strong> @(r.CreatedAt?.ToLocalTime().ToString("MMM d, yyyy h:mm tt"))</p>
    }
    @if (r.Activity.Count == 0)
    {
        <p class="note">No changes recorded yet.</p>
    }
    <ul class="activity">
        @foreach (var e in Enumerable.Reverse(r.Activity))
        {
            var other = r.CreatedBy is { } c && !FuelIntake.Core.Activity.ActivityLog.SamePerson(c, e.By);
            <li class="@(other ? "other" : "")">
                <div>
                    <strong>@e.At.ToLocalTime().ToString("MMM d, h:mm tt")</strong> — @e.By.Name
                    @if (other) { <span class="badge other-staff">other staff</span> }
                    · @(e.Action == "Created" ? "created the intake" : $"changed {e.Changes.Count} field{(e.Changes.Count == 1 ? "" : "s")}")
                </div>
                @if (e.Changes.Count > 0)
                {
                    <details>
                        <summary>Show changes</summary>
                        <table class="changes">
                            @foreach (var ch in e.Changes)
                            {
                                <tr><td>@ch.Field</td><td class="from">@(string.IsNullOrEmpty(ch.From) ? "(blank)" : ch.From)</td><td>→</td><td>@(string.IsNullOrEmpty(ch.To) ? "(blank)" : ch.To)</td></tr>
                            }
                        </table>
                    </details>
                }
            </li>
        }
    </ul>
</section>

@code {
    private static string Title(IssueSeverity s) => s switch
    {
        IssueSeverity.Error => "Errors",
        IssueSeverity.Warning => "Warnings",
        _ => "Notes",
    };

    private static Screen ScreenFor(string section) => section switch
    {
        "Household" => Screen.Household,
        "Application" => Screen.Application,
        "Income & Expenses" => Screen.IncomeExpenses,
        "Fuel & Electric" => Screen.FuelElectric,
        _ => Screen.Client,
    };
}
