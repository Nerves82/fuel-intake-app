@implements IDisposable
@inject IntakeSession Session
@inject HostInfo Host
@inject FuelIntake.Core.Storage.IFileOutput Output
@inject Microsoft.JSInterop.IJSRuntime JS

<header class="app-header">
    <div class="brand">
        <img src="_content/FuelIntake.UI/nekca-logo.png" alt="NEKCA" />
        <span>Fuel Assistance Intake</span>
        <span class="version" title="@($"Version {Host.AppVersion}")">v@(ShortVersion)</span>
    </div>
    @if (Session.Record is { } r)
    {
        <div class="client-name">
            @if (r.IsTestData) { <span class="badge test">TEST</span> }
            @Session.Calc?.ClientFullName
        </div>
        <div class="save-state">
            @if (Session.SaveConflict)
            {
                <span class="problem">Not saved: changed on another computer</span>
            }
            else if (Session.SaveError is not null)
            {
                <span class="problem" title="@Session.SaveError">Not saved: @Session.SaveError</span>
            }
            else if (Session.HasUnsavedChanges)
            {
                <span>Saving…</span>
            }
            else if (Session.LastSaved is { } t)
            {
                <span>Saved @t.ToLocalTime().ToString("h:mm tt")</span>
            }
        </div>
        <button class="secondary @(Session.NotesOpen ? "on" : "")" @onclick="Session.ToggleNotes" title="Show or hide notes (stays open across tabs)">
            Notes@(r.Notes.Count > 0 ? $" ({r.Notes.Count})" : "")
        </button>
        <button class="secondary @(Session.RulesOpen ? "on" : "")" @onclick="Session.ToggleRules" title="Show or hide the Vermont Crisis Fuel rules">Rules</button>
        <button class="secondary" @onclick="OpenFolder" title="Open this client's folder in File Explorer">Open folder</button>
        <button class="secondary" @onclick="Session.CloseAsync">Close client</button>
        @ThemeButton
    }
    else
    {
        <div class="spacer"></div>
        <span class="user">@Session.User.DisplayName</span>
        @if (Session.Screen is Screen.Check or Screen.Settings)
        {
            <button class="secondary" @onclick="() => Session.Go(Screen.Clients)">Back to clients</button>
        }
        else
        {
            <button class="link" @onclick="() => Session.Go(Screen.Settings)">Staff, vendors &amp; settings</button>
            <button class="link" @onclick="() => Session.Go(Screen.Check)">Check this computer</button>
        }
        @ThemeButton
    }
</header>

@code {
    /// <summary>"0.1.29" from "0.1.29 (a1b2c3d)".</summary>
    private string ShortVersion => Host.AppVersion.Split(' ', '+')[0];

    protected override void OnInitialized() => Session.StateChanged += OnState;

    private async Task OpenFolder()
    {
        if (Session.Folder is not { } f) return;
        try { await Output.OpenAsync(f.Id); }
        catch (Exception ex) { Session.ShowNotice("Couldn't open the folder: " + ex.Message); }
    }

    // ---- light / dark mode: System → Light → Dark → System …
    private string? theme; // null until the script answers (static preview: no button)

    private RenderFragment ThemeButton => @<button class="theme-toggle" title="@ThemeTitle" aria-label="@ThemeTitle" @onclick="NextTheme">@ThemeIcon</button>;

    private string ThemeIcon => theme switch { "light" => "☀", "dark" => "☾", _ => "◐" };
    private string ThemeTitle => theme switch
    {
        "light" => "Light mode (click for dark)",
        "dark" => "Dark mode (click to follow Windows)",
        _ => "Following Windows light/dark setting (click for light)",
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { theme = await JS.InvokeAsync<string>("fuelIntake.getTheme"); StateHasChanged(); }
        catch (Exception) { /* static preview: no script */ }
    }

    private async Task NextTheme()
    {
        var next = theme switch { "system" => "light", "light" => "dark", _ => "system" };
        try { await JS.InvokeAsync<string>("fuelIntake.setTheme", next); theme = next; }
        catch (Exception) { }
    }
    private void OnState() => InvokeAsync(StateHasChanged);
    public void Dispose() => Session.StateChanged -= OnState;
}
