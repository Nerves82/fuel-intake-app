<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- UI: the screens, as Razor components. Hosted by the desktop app (phase 1)
       and the web app (phase 2). Screens talk only to Core interfaces, never to Windows directly. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FuelIntake.UI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FuelIntake.Core\FuelIntake.Core.csproj" />
  </ItemGroup>

</Project>
