<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- UI: the screens, as Razor components. Hosted by the desktop app (phase 1)
       and the web app (phase 2). Screens talk only to Core interfaces, never to Windows directly. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FuelIntake.UI</RootNamespace>
  </PropertyGroup>

  <!-- Uses the ASP.NET Core framework that ships with .NET (no package download needed). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Printing\nekca-logo.png" LogicalName="nekca-logo.png" />
    <EmbeddedResource Include="Printing\forms.css" LogicalName="forms.css" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FuelIntake.Core\FuelIntake.Core.csproj" />
  </ItemGroup>

</Project>
