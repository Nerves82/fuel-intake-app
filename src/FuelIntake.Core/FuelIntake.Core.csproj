<Project Sdk="Microsoft.NET.Sdk">

  <!-- Core: data model, validation, FPL, mappings. No UI and no Windows-only code,
       so it is shared unchanged by the desktop app (phase 1) and the web app (phase 2). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FuelIntake.Core</RootNamespace>
  </PropertyGroup>

  <!-- Built-in starting vendor list (Microsoft Lists CSV export). Staff can re-import a newer export in Settings. -->
  <ItemGroup>
    <EmbeddedResource Include="Data\Fuel_Team_Vendor_List.csv" LogicalName="Fuel_Team_Vendor_List.csv" />
    <!-- Answer boxes on the forms the app prints for clients to fill in by hand (reference/forms/make_scan_layout.js). -->
    <EmbeddedResource Include="Import\scan-forms.json" LogicalName="scan-forms.json" />
  </ItemGroup>

</Project>
