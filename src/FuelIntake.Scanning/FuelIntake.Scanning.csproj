<Project Sdk="Microsoft.NET.Sdk">

  <!-- Reading scans with PaddleOCR (PP-OCRv5 Latin models, ONNX Runtime) through RapidOcrNet. Cross-platform, so the
       recognition runs in the tests too; the desktop app adds Windows' PDF rendering and image decoding. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FuelIntake.Scanning</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RapidOcrNet" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FuelIntake.Core\FuelIntake.Core.csproj" />
  </ItemGroup>

</Project>
